# Express server
PORT=5175

# Docker Compose MongoDB hostname and database name.
# Use mongodb://localhost:27017/Torrent when running the backend outside Docker.
MONGO_URI=mongodb://mongo:27017/Torrent

# Use the same Google OAuth web client ID in frontend/.env.
GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com

# Replace this with a long, random value in your local .env.
JWT_SECRET=<your openssl rand -base64 32>
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Keep false for local HTTP. Set true when deployed behind HTTPS.
COOKIE_SECURE=false

# Fetch procurement data when the backend starts.
FETCH_ON_STARTUP=true
